<component type="desktop-application">
  <id>io.github.spike848.BACKCORD</id>
  <name>BACKCORD</name>
  <summary>A Discord client without the web browser</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>Unlicense</project_license>
  <developer id="io.github.spike848">
    <name>Spike84</name>
  </developer>
  <description>
    <p>
      BACKCORD talks to Discord's API itself and draws its own window with iced,
      so it runs in about 30 MB of RAM, where Discord's own app takes 720.
    </p>
    <p>
      Servers, DMs, threads, forums, friends, voice, screen sharing and GIFs are
      all there, laid out the way Discord lays them out.
    </p>
  </description>
